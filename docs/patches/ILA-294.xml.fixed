    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title><rs type="textType">Iscrizione greca</rs> Stele con consultazione oracolare e ringraziamento a Men Petraeites Axetenos, provenienza ignota (Museo di Uşak)</title>
            </titleStmt>
            <publicationStmt>
