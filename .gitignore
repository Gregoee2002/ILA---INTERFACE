node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Draft CMRDM (estrazioni Vision non revisionate): ora sincronizzati da
# Gregoee2002/ILA, cartella drafts/ (vedi githubStorage.ts). Il filesystem
# locale resta solo una cache, popolata al boot dal server — non va più
# tracciata qui, per non tenere due fonti di verità divergenti.
src/data/corpus-drafts/

# Scatto statico del corpus generato a build time per la build GitHub Pages
# (vedi scripts/build-corpus-snapshot.ts) — contiene il corpus vero, mai da
# committare: viene rigenerato ad ogni deploy dal workflow Actions.
public/corpus-snapshot.json

# Corpus principale: fonte di verità è Gregoee2002/ILA (repo dati). Questa
# cartella è solo una cache locale ripopolata al boot dal server dev
# (pullCorpusFromGitHub, vedi githubStorage.ts) e dalla build GH Pages
# (build-corpus-snapshot.ts). Non va tracciata qui: ogni modifica arriva già
# al repo dati via pushFileToGitHub, tenerla anche qui duplica la fonte di
# verità e genera commit rumorosi.
src/data/corpus/
__pycache__/

# Runner autonomo: ledger di stato e log delle run. Non vanno tracciati —
# se lo fossero, finirebbero nei commit dei branch auto/* e sporcherebbero
# il diff da revisionare (e lo stato si azzererebbe ad ogni checkout di main).
.autonomous/
.autonomous.lock
logs/

# Copia del corpus arricchita col percorso LARES (scripts/export-lares.ts):
# si rigenera, non è una fonte.
exports/lares/
