                                <support>
                                    <p>Statuetta bronzea, nel Rijksmuseum van Oudheden di Leida dal 1897. Si dice provenga da Antalya. Altezza 14 cm.</p>
                                    <material ref="https://www.eagle-network.eu/voc/material/lod/109.html">bronze</material>
                                    <objectType ref="https://www.eagle-network.eu/voc/objtyp/lod/24.html">relief</objectType>
