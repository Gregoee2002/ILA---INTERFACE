                                <support>
                                    <p>Altare con decorazione scolpita, rinvenuto nel santuario di Hera di Pergamum nel 1910-11.</p>
                                    <material ref="https://www.eagle-network.eu/voc/material/lod/138.html">stone</material>
                                    <objectType ref="https://www.eagle-network.eu/voc/objtyp/lod/29.html">altar</objectType>
                                    <dimensions>
                                        <height unit="cm">110</height>
                                        <width unit="cm">49</width>
                                        <depth unit="cm">49</depth>
                                    </dimensions>
                                </support>
                            </supportDesc>
                            <layoutDesc>
                                <layout>
                                    <p>Altare con due teste di capra collegate da ghirlande, grappoli d&apos;uva, maschera sul lato anteriore, cista a sinistra, kantharos a destra, e due capsule di papavero. Iscrizione sopra la maschera.</p>
                                    <rs ref="http://www.eagle-network.eu/voc/writing/lod/1">incisa a scalpello</rs>
                                </layout>
                            </layoutDesc>
                        </objectDesc>
