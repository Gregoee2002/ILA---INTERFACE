            <!-- REVISIONE (cross-check PDF Lane p. 22-23): "σμε΄" -> "σμς΄" (l. 1, numerale anno errato: 246 dell'era sillana = 161/2 d.C., coerente con la data già presente nel file); "Πετραεύτου" -> "Πετραείτου" (l. 2); "Ἄψιον" -> "Ἄπφιον", "Ἀψιάς" -> "Ἀπφίας" (compare 2 volte: digrafo πφ scambiato per ψ); "Δεκοῦνδος" -> "Σεκοῦνδος" (nome Secundus, Δ/Σ scambiati); "Ἥραις" -> "Ἡραΐς"; "Ἄπελλάς" (dopo Ἀψιάς) -> "Ἀσκλᾶς" (nome sostituito con un duplicato di Ἀπελλᾶς, già presente più avanti nella lista); "Πεῖσα" -> "Πεία"; aggiunta provenienza dettagliata (chiesa di Hagios Taxiarches, Gyölde, parete ovest, a sinistra dell'ingresso, trovata prima del 1870), assente nel draft; Pleiades ref corretto 609032 (ID inesistente/404) -> 609441 (Kollyda/Goloida = Gölde, verificato via Pleiades API e Trismegistos TM Geo 33613); TM non trovato. -->
            <sourceDesc>
                <msDesc>
                    <msIdentifier>
                        <repository>in situ or lost</repository>
                    </msIdentifier>
                    <physDesc>
                        <objectDesc>
                            <supportDesc>
                                <support>
                                    <p>Base bassa di marmo bianco con modanature sopra e sotto, rinvenuta prima del 1870 nella chiesa di Hagios Taxiarches a Gyölde, parete ovest, esterno, a sinistra dell'ingresso. Altezza 24 cm., larghezza 54 cm. Le prime tre righe dell'iscrizione sono sulla modanatura superiore.</p>
                                    <material ref="https://www.eagle-network.eu/voc/material/lod/48.html">marble</material>
                                    <objectType ref="https://www.eagle-network.eu/voc/objtyp/lod/57.html">base</objectType>
                                    <dimensions unit="cm">
                                        <height>24</height>
                                        <width>54</width>
                                        <depth></depth>
                                    </dimensions>
                                </support>
                            </supportDesc>
                            <layoutDesc>
                                <layout>
                                    <p>Base bassa con modanature, recante una dedica dei Kataloustikoi (membri dell'associazione) a Meter, Men Tiamos e Men Petraeutos, con lunga lista di dedicanti.</p>
                                    <rs ref="http://www.eagle-network.eu/voc/writing/lod/1">incisa a scalpello</rs>
                                </layout>
                            </layoutDesc>
                        </objectDesc>
                        <handDesc>
                            <handNote>
                                <p>Altezza delle lettere: da 0,8 cm a 1,4 cm.</p>
                            </handNote>
                        </handDesc>
                    </physDesc>
