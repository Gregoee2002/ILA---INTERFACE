                            <layoutDesc>
                                <layout>
                                    <p>Base bassa con modanature, recante una dedica dei Kataloustikoi (membri dell'associazione) a Meter, Men Tiamos e Men Petraeutos, con lunga lista di dedicanti.</p>
                                    <rs ref="http://www.eagle-network.eu/voc/writing/lod/1">incisa a scalpello</rs>
                                </layout>
