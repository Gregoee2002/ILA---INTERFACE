            <div type="edition" xml:space="preserve" xml:lang="grc">
<ab>
                    <lb n="1"/><persName type="divine" key="Magna Mater"><name>Matri</name> <name>Deum</name> <name>Magnae</name>
                    <lb n="2" break="no"/><name>Idaeae</name> <rs type="epithet">Summae Pa-
                    <lb n="3" break="no"/>renti</rs></persName>, Hermae, et <persName type="divine" key="Attis"><name>Attidi</name></persName>
                    <lb n="4"/><persName type="divine" key="Men Tyrannos"><name nymRef="Μήν">Menotyranno</name> <rs type="epithet">Invicto</rs></persName>
                    <lb n="5"/><persName type="attested" key="Clodius Hermogianus Caesarius"><name>Clodius</name> <name>Hermogianus</name> <name>Caesarius</name></persName>
                    <lb n="6"/>V(ir) C(onsularis) Procons. Africae
                    <lb n="7"/>Praefect. Urbis Romae
                    <lb n="8"/>XVvir S(acris) F(aciundis) taurobolio
                    <lb n="9"/>criobolioque perfecto XIII Kal. Aug. diis animae
                    <lb n="10"/>suae mentisque costodibus
                    <lb n="11"/>aram dicavit
                    <lb n="12"/>D(omino) N(ostro) Gratiano Aug. ter
                    <lb n="13"/>et ...... Aequitio conss.
                </ab>
