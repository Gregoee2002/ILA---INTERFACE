    <text>
        <body>
            <div type="edition" xml:space="preserve" xml:lang="grc">
                <ab>
                    <lb n="1"/>Ἔτους σγ΄, μη(νὸς) Ἀρτεμεισίου ς΄, ἐ-
                    <lb n="2"/>πὶ <persName type="attested" key="Trophime figlia di Artemidoros Kikinnas"><name nymRef="Τροφίμη">Τροφίμη</name>, <persName type="attested" key="Artemidoros Kikinnas"><name type="patronymic" nymRef="Ἀρτεμίδωρος">Ἀρτεμιδώρου</name> <name type="patronymic" nymRef="Κικιννάς">Κι-
                    <lb n="3" break="no"/>κιννάδος</name></persName></persName> κληθεῖσα ὑπὸ τοῦ
                    <lb n="4"/>θεοῦ εἰς ὑπηρεσίας χάριν μὴ
                    <lb n="5"/>βουληθοῦσα ταχέως προσελ-
                    <lb n="6"/>θεῖν ἐκολάσετο αὐτὴν καὶ μα-
                    <lb n="7"/>νῆναι ἐποίησεν. Ἠρώτησε οὖν <persName type="divine" key="Meter Tarsene"><name nymRef="Μήτηρ">Μη-
                    <lb n="8" break="no"/>τέρα</name> <rs type="epithet">Ταρσηνὴν</rs></persName> καὶ <persName type="divine" key="Apollon Tarsios"><name nymRef="Ἀπόλλων">Ἀπόλλωνα</name> <rs type="epithet">Ταρσί-
                    <lb n="9" break="no"/>ον</rs></persName> καὶ <persName type="divine" key="Men Artemidorou Axiottenos"><name nymRef="Μήν">Μῆνα</name> <rs type="epithet">Ἀρτεμιδώρου Ἀξι-
                    <lb n="10" break="no"/>οττηνὸν</rs></persName> Κόρεσα κατέχοντα
                    <lb n="11"/>καὶ ἐκέλευσεν στηλλογραφ-
                    <lb n="12"/>ηθῆναι νέμεσιν καὶ καταγρά-
                    <lb n="13"/>ψαι ἐμαυτὸν εἰς ὑπηρεσίαν
                    <lb n="14"/>τοῖς θεοῖς.
                </ab>
            </div>
