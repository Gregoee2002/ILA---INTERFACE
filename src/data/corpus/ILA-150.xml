                    <physDesc>
                        <objectDesc>
                            <supportDesc>
                                <support>
                                    <p>Tavoletta con epigramma palindromo dal santuario di Men Askaenos, Antiocheia Pisidiae, di cui furono trovati cinque frammenti nello scavo del 1912; ora nel Museo Archeologico di Konya. Altezza, ricomposta in gesso nel museo, 39,5 cm, larghezza 24 cm.</p>
                                    <material ref="https://www.eagle-network.eu/voc/material/lod/138.html">stone</material>
                                    <objectType ref="https://www.eagle-network.eu/voc/objtyp/lod/250.html">stone</objectType>
