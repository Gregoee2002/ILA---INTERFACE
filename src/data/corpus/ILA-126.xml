                    <physDesc>
                        <objectDesc>
                            <supportDesc>
                                <support>
                                    <p>Statuetta bronzea di Men stante, acquisita dal Fogg Art Museum, Harvard University, nel 1964; provenienza incerta. Altezza 13,5 cm.</p>
                                    <material ref="https://www.eagle-network.eu/voc/material/lod/109.html">bronze</material>
                                    <objectType ref="https://www.eagle-network.eu/voc/objtyp/lod/24.html">relief</objectType>
