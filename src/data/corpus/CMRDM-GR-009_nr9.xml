    <text>
        <body>
            <div type="edition" xml:space="preserve" xml:lang="grc">
                <ab>
                    <lb n="1"/><persName type="attested" key="Dionysios"><name nymRef="Διονύσιος">Διονύσιος</name></persName> καὶ <persName type="attested" key="Babilylia"><name nymRef="Βαβυλια">Βαβυλία</name></persName> τῷ <persName type="divine" key="Men"><name nymRef="Μήν">Μηνὶ</name></persName> τὸ ἱερὸν ἀνέθεσαν.
                </ab>
            </div>
            <div type="translation" xml:lang="it">
                <p>Dionysios e Babylia dedicarono il santuario a Men</p>
            </div>
            <div type="translation" xml:lang="en">
                <p>Dionysios and Babylia dedicated the sanctuary to Men</p>
            </div>
