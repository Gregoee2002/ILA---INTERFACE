    <text>
        <body>
            <div type="edition" xml:space="preserve" xml:lang="grc">
                <ab>
                    <lb n="1"/>ςςςςα΄ κε΄ <persName type="divine" key="Men Phosphoros"><name nymRef="Μήν">Μηνὸς</name> <rs type="epithet">Φωσφόρου</rs></persName>
                    <lb n="2"/>τέσσαρες ἐξεῖται, πέμπτος χεῖος, τάδε φράζει,
                    <lb n="3"/>ὡς ἄρνας κατέχουσι λύκοι κρατεροί τε λέοντες
                    <lb n="4"/>βοῦς ἕλικας, πάντων τούτων καὶ σύ κρατήσεις
                    <lb n="5"/>καὶ πάντ᾽ ἔσται σοι, ὅσ᾽ ἐπερωτᾷς, σὺν <persName type="divine" key="Zeus">Διὸς</persName> <persName type="divine" key="Hermes">Ἑρμῇ</persName>.
                </ab>
