                                <placeName type="modern" ref="DA_COMPILARE">Ennek, Turkey</placeName>
                                <placeName type="region">Asia Minor</placeName>
                            </origPlace>
                            <origDate datingMethod="#julian" precision="low"></origDate>
                        </origin>
                        <provenance type="found">Ennek, Turchia</provenance>
                        <provenance type="observed" subtype="autopsied">Nessuna.</provenance>
                    </history>
                </msDesc>
