                    <physDesc>
                        <objectDesc>
                            <supportDesc>
                                <support>
                                    <p>Stele di marmo bianco, più larga alla base, spezzata alla base, danneggiata in alto a destra e a sinistra. Rinvenuta nel 1911 in un campo appena a est di Ayazviran, trasportata nella casa di Secbekoğlu Mustafa. Altezza 42 cm., larghezza in cima 34,5 cm., alla base 37 cm., spessore 5 cm.</p>
                                    <material ref="https://www.eagle-network.eu/voc/material/lod/48.html">marble</material>
                                    <objectType ref="https://www.eagle-network.eu/voc/objtyp/lod/250.html">stele</objectType>
                                    <dimensions unit="cm">
                                        <height>42</height>
                                        <width></width>
                                        <depth>5</depth>
                                    </dimensions>
                                </support>
                            </supportDesc>
                            <layoutDesc>
                                <layout>
                                    <p>Stele di confessione (stele di propiziazione) che registra la punizione divina e l'erezione di un'iscrizione di confessione da parte di Iulia Metra, dedicata a Megale Meter Tasene, Men Lasanas e Men Artemidarou.</p>
                                    <rs ref="http://www.eagle-network.eu/voc/writing/lod/1">incisa a scalpello</rs>
                                </layout>
                            </layoutDesc>
                        </objectDesc>
                        <handDesc>
                            <handNote>
                                <p>Altezza delle lettere: da 1,5 a 1,6 cm.</p>
                            </handNote>
                        </handDesc>
