            <div type="edition" xml:space="preserve" xml:lang="la">
                <ab>
                    <lb n="1"/>Diis Magnis
                    <lb n="2"/><persName type="divine" key="Magna Mater"><name>M(atri)</name> <name>D(eum)</name> <name>M(agnae)</name> <name>I(daeae)</name></persName> et
                    <lb n="3"/><persName type="divine" key="Attis Sanctus"><name>Attidi</name> <rs type="epithet">Sancto</rs></persName> <persName type="divine" key="Men Tyrannos"><name nymRef="Μήν">Menotyranno</name></persName>
                    <lb n="4"/><persName type="attested" key="Alfenius Ceionus Iulianus Kamenius"><name>Alfenius</name> <name>Ceionus</name> <name>Iulianus</name>
                    <lb n="5" break="no"/><name>Kamenius</name></persName> V(ir) C(onsularis) VIIvir Epul(onum)
                    <lb n="6"/>Pater et Hieroceryx sacr(orum) S(ummi) I(nvicti)
                    <lb n="7"/>Mitrae, Hierofanta Haecatae,
                    <lb n="8"/>Archboucolus Dei Liberi
                    <lb n="9"/>aram taurobolio criobolio-
                    <lb n="10"/>que percepto dicabit
                    <lb n="11"/>die XIII Kal. Aug. D(omino) N(ostro) Gratiano
                    <lb n="12"/>Aug. III et Equitio Conss.
                </ab>
