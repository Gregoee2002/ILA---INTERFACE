                    <physDesc>
                        <objectDesc>
                            <supportDesc>
                                <support>
                                    <p>Pilastro cilindrico di calcare bluastro, spezzato in basso. Trovato nel 1908 da W. M. Calder, accanto a una moschea. Altezza 79 cm, circonferenza 1.23 m.</p>
                                    <material ref="https://www.eagle-network.eu/voc/material/lod/138.html">limestone</material>
                                    <objectType ref="https://www.eagle-network.eu/voc/objtyp/lod/103.html">column</objectType>
                                    <dimensions unit="cm">
                                        <height>79</height>
                                        <width></width>
                                        <depth></depth>
                                    </dimensions>
                                </support>
                            </supportDesc>
                            <layoutDesc>
                                <layout>
                                    <p>La pietra reca l'iscrizione seguente, che inizia a 63 cm dalla sommità. Dedica per la salvezza del popolo di Appola a Men Askaienos, da parte di Demosthenes figlio di Diotimos.</p>
                                    <rs ref="http://www.eagle-network.eu/voc/writing/lod/1">incisa a scalpello</rs>
                                </layout>
