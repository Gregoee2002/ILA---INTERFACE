                                        <width>38</width>
                                        <depth></depth>
                                    </dimensions>
                                </support>
                            </supportDesc>
                            <layoutDesc>
                                <layout>
                                    <p>Pietra con iscrizione funeraria per una moglie, seguita da maledizione che invoca Men Katachthonios contro chiunque danneggi la stele.</p>
                                    <rs ref="http://www.eagle-network.eu/voc/writing/lod/1">incisa a scalpello</rs>
                                </layout>
