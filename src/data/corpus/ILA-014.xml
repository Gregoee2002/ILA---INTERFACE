            <div type="edition" xml:space="preserve" xml:lang="grc">
                <ab>
                    <lb n="1"/><persName type="divine" key="Megale Meter Tazene"><name nymRef="Μεγάλη">[Με]γάλη</name> <name nymRef="Μήτηρ">Μήτ[ηρ</name> <rs type="epithet">Ταζη-
                    <lb n="2" break="no"/>νή]</rs></persName> καὶ <persName type="divine" key="Men Labanas"><name nymRef="Μήν">Μὶς</name> <rs type="epithet">Λαβάνας</rs></persName> [καὶ]
                    <lb n="3"/><persName type="divine" key="Men Artemidorou Dorou"><name nymRef="Μήν">Μὶς</name> <rs type="epithet">Ἀρτεμιδώρου Δό-
                    <lb n="4" break="no"/>ρου</rs></persName> κώμην βασιλεύον-
                    <lb n="5" break="no"/>τες. Ἔτους σκη΄, μη(νὸς) Δαισί-
                    <lb n="6" break="no"/>ου Σε(βαστῇ), <persName type="attested" key="Ioulia Metra"><name nymRef="Ἰουλία">Ἰουλία</name> <name nymRef="Μήτρα">Μητρὰ</name></persName> ἀνέ-
                    <lb n="7" break="no"/>στησε στήλλην ἐπιζητη-
                    <lb n="8"/>σάντων τῶν θεῶν τὴν γ[ε-]
                    <lb n="9"/>γόνουσαν ἁμαρτίαν ὑ[πὸ]
                    <lb n="10"/>[...]
                </ab>
