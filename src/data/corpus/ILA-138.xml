                <ab>
                    <lb n="1"/><persName type="attested" key="Marcus Aelius Oktaouios"><name>Μ.</name> <name nymRef="Αίλιος">Αἴλιος</name> <name nymRef="Οχτάουιος">Ὀχ[τ]ά-
                    <lb n="2" break="no"/>ουιος</name></persName> ἑαυτῷ
                    <lb n="3"/>ζῶν καὶ γυναικὶ
                    <lb n="4"/><persName type="attested" key="Domnilla"><name nymRef="Δομνίλλα">Δομνίλλῃ</name></persName> καὶ
                    <lb n="5"/>τέκνοις ἐποίησεν
                    <lb n="6"/>τὴν λάρνακα καὶ
                    <lb n="7"/>τὸν βωμόν, ἑτέρῳ
                    <lb n="8"/>δὲ μηδενὶ ἐξὸν
                    <lb n="9"/>εἶναι εἰσενεχθ[ῆ-]
                    <lb n="10"/>ναι. Ἐὰν δέ τις ἐ-
                    <lb n="11"/>πεισβιάσηται
                    <lb n="12"/>ἔχοιτο <persName type="divine" key="Men Katachthonios"><name nymRef="Μήν">Μῆνα</name> <rs type="epithet">Κα-
                    <lb n="13" break="no"/>ταχθόνιον</rs></persName> κε-
                    <lb n="14"/>χολωμένον.
                </ab>
