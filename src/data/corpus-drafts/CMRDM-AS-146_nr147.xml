            <div type="edition" xml:space="preserve" xml:lang="grc">
                <ab>
                    <lb n="1"/>Δάρχιο[ς ............]
                    <lb n="2"/>ζῶν ἑαυ[τῷ καὶ τῇ γυναικὶ]
                    <lb n="3"/>Πωσιλά[ῃ καὶ τοῖς τέκνοις]
                    <lb n="4"/>τὴν σο[ρὸν κατεσκεύασεν.]
                    <lb n="5"/>Ἐνορκῶ δε Μῆνα Κατάχθόνιον]
                    <lb n="6"/>καὶ θεοὺς [κατάχθονιους μη-]
                    <lb n="7"/>δένα ἀδικ[ήσειν τὸ μνῆμα μη-]
                    <lb n="8"/>δε ἐπεισε[νεγκεῖν σῶμα, ὃς δ᾽]
                    <lb n="9"/>ἂν ἐπείσε[νέγκῃ ἤ ἀδικήσῃ, δώσει]
                    <lb n="10"/>τῷ φίσκῳ [δηνάρια δισχίλια]
                    <lb n="11"/>πεντακόσ[ια καὶ ἕξει Μῆνα κε-]
                    <lb n="12"/>κολωμένο[ν.]
                </ab>
