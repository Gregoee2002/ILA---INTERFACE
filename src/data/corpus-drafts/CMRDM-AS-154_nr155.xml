            <div type="edition" xml:space="preserve" xml:lang="grc">
                <ab>
                    <lb n="1"/>Διαδούμε-
                    <lb n="2"/>νος ἑαυτῷ καὶ
                    <lb n="3"/>Ἡλιάδι τῇ συνεί-
                    <lb n="4"/>δι τὸν βωμὸν
                    <lb n="5"/>καὶ τὴν στήλην
                    <lb n="6"/>καὶ τὰ πέλτα, καὶ
                    <lb n="7"/>ἐνορκῶ τρεῖς θ[εοὺς]
                    <lb n="8"/>Μῆνας ἀνεπιτά[κτως]
                    <lb n="9"/>μηδένα ἕτερον ε-
                    <lb n="10"/>πεισενεχθῆναι ἢ
                    <lb n="11"/>μόνην Ἀρτεμεισίαν ἣν
                    <lb n="12"/>ἐμήν,
                </ab>
