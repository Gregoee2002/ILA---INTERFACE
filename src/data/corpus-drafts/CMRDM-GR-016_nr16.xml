    <text>
        <body>
            <div type="edition" xml:space="preserve" xml:lang="grc">
                <ab>
                    <lb n="1"/>τ[ὸν] μαθ[ε]ντος ὑπὸ Ἁλιαστᾶν Ἀθαναϊαστᾶν Ἑρμαϊαστᾶν Ἀ[ρ]ίστιδειων
                    <lb n="2"/>κοινοῦ χρυσέῳ στεφάνῳ, καὶ ὑπὸ Δίος Σωτηριαστᾶν
                    <lb n="3"/>Σαραπιαστᾶν κοινοῦ θαλίνῳ στεφάνῳ,
                    <lb n="4"/>καὶ ὑπὸ Σαραπιαστᾶν χρυσέῳ στεφάνῳ· καὶ ὑπὸ Μηνιαστᾶν
                    <lb n="5"/>Ἀφροδισιαστᾶν κοινοῦ χρυσέῳ στεφάνῳ, καὶ ὑπὸ Σωτηριαστᾶν
                    <lb n="6"/>Ἀσκλαπιαστᾶν Ποσειδανιαστᾶν Ἀθαναϊαστᾶν Ἀφροδισιαστᾶν
                    <lb n="7"/>Ἑρμίαστᾶν Ματρὸς θεῶν κοινοῦ χρυσέῳ στεφάνῳ [καὶ] ὑπὸ
                    <lb n="8"/>Ἑστιαστᾶν κοινοῦ θαλίνῳ στεφάνῳ.
                </ab>
