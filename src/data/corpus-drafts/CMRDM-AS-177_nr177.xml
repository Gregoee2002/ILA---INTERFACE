                            <supportDesc>
                                <support>
                                    <p>White marble stele with bull at altar and inscription, Antiocheia Pisidiae. Height 1.145 m., width at bottom 58.8 cm., width of upper moulding 59 cm., thickness 3.5 to 4 cm.</p>
                                    <material ref="https://www.eagle-network.eu/voc/material/lod/48.html">marble</material>
                                    <objectType ref="https://www.eagle-network.eu/voc/objtyp/lod/250.html">stele</objectType>
